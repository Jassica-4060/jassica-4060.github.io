      "2": { "$value": "#91cc75", "$type": "color" },
      "3": { "$value": "#fac858", "$type": "color" },
      "4": { "$value": "#ee6666", "$type": "color" }
    }
  },

  "category": {
    "$description": "訊息型別分類識別色（純粹用於區分 9 種訊息型別的圖示顏色），沿用 Tailwind v4 內建色盤的 OKLCH 值。v2 未變動（決議 2026-10-02：影片保留紫色 violet-500）。",
