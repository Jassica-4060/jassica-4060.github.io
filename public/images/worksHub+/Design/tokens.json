    "carousel": { "$value": "oklch(71.5% 0.143 215.221)", "$type": "color" },
    "file": { "$value": "oklch(55.4% 0.046 257.417)", "$type": "color" },
    "list": { "$value": "oklch(58.5% 0.233 277.117)", "$type": "color" },
    "quick-reply": { "$value": "oklch(65.6% 0.241 354.308)", "$type": "color" }
  },

  "size": {
    "text-2xs": { "$value": "0.625rem", "$type": "dimension" },
    "button-height": { "$value": "42px", "$type": "dimension", "$description": "主要／次要按鈕（新增使用者、匯出名單、取消、確定）。" },
    "input-height-filter": { "$value": "40px", "$type": "dimension", "$description": "篩選列的下拉框。決議 2026-10-02：與彈窗輸入框不需一致。" },
    "input-height-modal": { "$value": "46px", "$type": "dimension", "$description": "彈窗內的輸入框／下拉框。" }
  },

  "radius": {
    "$description": "v2 圓角規則：按鈕、篩選列下拉框、狀態 badge、麵包屑為膠囊；以下照設計稿保留一般圓角（決議 2026-10-02）：彈窗輸入框 12px、角色標籤 8px、表格操作 icon 按鈕 10px、header icon 按鈕 8px、彈窗關閉鈕正圓。容器照圓角版。sm/md 保留 v1 的 key 名稱（對應 NaiveUI borderRadiusSmall/borderRadius），值改為膠囊。NaiveUI 的 Card/Modal/Dialog/Popover/Dropdown 與 Tag、彈窗內 Input/Select 會吃 common.borderRadius，需另外用下方 token 覆寫（見差異說明）。",
    "sm": { "$value": "9999px", "$type": "dimension", "$description": "NaiveUI borderRadiusSmall → 膠囊。" },
    "md": { "$value": "9999px", "$type": "dimension", "$description": "NaiveUI borderRadius → 膠囊。" },
    "pill": { "$value": "9999px", "$type": "dimension", "$description": "按鈕、篩選列下拉框、狀態 badge、麵包屑、使用者膠囊。" },
    "circle": { "$value": "50%", "$type": "dimension", "$description": "使用者頭像、彈窗關閉鈕。" },
    "dot": { "$value": "2px", "$type": "dimension", "$description": "分組標題前的小方塊。" },
    "tag": { "$value": "8px", "$type": "dimension", "$description": "角色標籤（Tag）。" },
    "icon-button-header": { "$value": "8px", "$type": "dimension", "$description": "header 的收合／深淺色按鈕（36×36）。" },
    "icon-button": { "$value": "10px", "$type": "dimension", "$description": "表格操作欄的編輯／刪除按鈕（34×34）。" },
    "input-modal": { "$value": "12px", "$type": "dimension", "$description": "彈窗內的輸入框／下拉框。" },
    "popover": { "$value": "12px", "$type": "dimension", "$description": "下拉選單展開的選項框（Dropdown / Select menu）、提示泡泡（Popover / Tooltip）。設計稿未畫，決議 2026-10-02 採用。" },
    "nav-sub-item": { "$value": "8px", "$type": "dimension" },
    "nav-item": { "$value": "10px", "$type": "dimension" },
    "avatar": { "$value": "12px", "$type": "dimension", "$description": "成員列表頭像（圓角方形）、彈窗標題 icon。" },
    "panel-group": { "$value": "12px", "$type": "dimension", "$description": "header 的 icon 按鈕群組、日期區塊外框。" },
    "section": { "$value": "14px", "$type": "dimension", "$description": "篩選列、空狀態區塊、空狀態 icon。" },
    "card": { "$value": "16px", "$type": "dimension", "$description": "側欄、主內容卡片（Card）。" },
    "modal": { "$value": "20px", "$type": "dimension", "$description": "彈窗（Modal/Dialog）。" }
  },

  "layout": {
    "$description": "跨元件重複出現的版面尺寸常數。v2 版面改為：header 橫跨整排、側欄與內容區為浮起的圓角卡片。",
    "sidebar-width": { "$value": "240px", "$type": "dimension", "$description": "v1 為 220px。" },
    "sidebar-collapsed-width": { "$value": "64px", "$type": "dimension" },
    "header-height": { "$value": "68px", "$type": "dimension" },
    "shell-gap": { "$value": "16px", "$type": "dimension", "$description": "側欄與內容卡片的間距，也是卡片離畫面左右下緣的距離。" },
    "content-padding": { "$value": "26px 32px 32px", "$type": "dimension", "$description": "主內容卡片內距（上 左右 下）。" },
    "min-width": {
      "$value": "1280px",
      "$type": "dimension",
      "$description": "全站最小舒適寬度規範（見 CONTRIBUTING.md 版面寬度/RWD 章節）。實作用 Tailwind 既有 min-w-7xl utility 表達，不建立對應的 CSS 變數。"
    },
    "avatar-lg": { "$value": "64px", "$type": "dimension" }
  }
