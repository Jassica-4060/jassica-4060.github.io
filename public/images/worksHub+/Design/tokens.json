{
  "$description": "單一真相來源（v2 圓角版，來源：WorksHub-圓角版.html）。改這個檔案後執行 `pnpm run tokens:build` 重新產生 src/design/tokens.generated.css 與 tokens.generated.ts。格式沿用 v1（W3C DTCG），取消主題色切換（只有 light / dark 兩種模式），新增 shadow / gradient 兩種 $type，其 $value 直接是 CSS 字串，build 腳本需新增這兩種類型的輸出。標記「推導」的值為圓角版設計稿沒有給、由設計色依規則推算。所有待確認項目已於 2026-10-02 拍板完成。與 v1 的差異請見 tokens-差異說明.html。",

  "neutral": {
    "$description": "中性色，只隨 light/dark 變化。v1 的 6 個 key 保留（值已換新），其餘為圓角版新增。",
    "light": {
      "shell-bg": { "$value": "#E6EBF0", "$type": "color", "$description": "最外層畫布底色（header 與浮起卡片後面那層）。" },
      "panel": { "$value": "#F8FAFB", "$type": "color", "$description": "側欄、header 按鈕群組、日期膠囊、使用者膠囊的底色。" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "主內容卡片、下拉框底色。" },
      "border": { "$value": "#D7DEE5", "$type": "color", "$description": "面板／卡片／彈窗外框。" },
      "text-title": { "$value": "#0F2740", "$type": "color", "$description": "標題、表格主要內容、已填值。" },
      "text-primary": { "$value": "#24313D", "$type": "color", "$description": "一般內文。" },
      "text-secondary": { "$value": "#617285", "$type": "color", "$description": "次要文字（email、時間、麵包屑、欄位標籤）。" },
      "text-muted": { "$value": "#7F8C9A", "$type": "color", "$description": "選單分組標題、表頭文字。" },
      "placeholder": { "$value": "#8A97A5", "$type": "color" },
      "nav-item-text": { "$value": "#33404D", "$type": "color" },
      "nav-item-icon": { "$value": "#64748A", "$type": "color" },
      "nav-sub-text": { "$value": "#4A5868", "$type": "color" },
      "nav-guide": { "$value": "#D3DAE1", "$type": "color", "$description": "子選單左側引導線、收合時的分隔線。" },
      "header-icon": { "$value": "#3C4B5B", "$type": "color" },
      "hover": { "$value": "#ECF0F3", "$type": "color", "$description": "選單項目、icon 按鈕、次要按鈕的 hover 底色。" },
      "subtle-bg": { "$value": "#EEF2F5", "$type": "color", "$description": "麵包屑膠囊、角色標籤底色。" },
      "section-bg": { "$value": "#F4F7F9", "$type": "color", "$description": "篩選列底色、空狀態區塊底色。" },
      "section-border": { "$value": "#CBD4DD", "$type": "color", "$description": "空狀態虛線框。" },
      "row-border": { "$value": "#ECEFF2", "$type": "color" },
      "row-hover": { "$value": "#F3F6F8", "$type": "color" },
      "input-bg": { "$value": "#F1F4F6", "$type": "color", "$description": "彈窗內輸入框底色（篩選列的下拉框用 surface）。" },
      "input-border": { "$value": "#E0E5EA", "$type": "color" },
      "secondary-bg": { "$value": "#EDF1F4", "$type": "color", "$description": "次要按鈕（取消、匯出名單）與表格操作 icon 按鈕底色。" },
      "secondary-text": { "$value": "#33404D", "$type": "color" },
      "modal-bg": { "$value": "#FFFFFF", "$type": "color" },
      "overlay": { "$value": "rgba(20,26,33,.45)", "$type": "color", "$description": "彈窗遮罩，搭配 backdrop-filter: blur(3px)。" }
    },
    "dark": {
      "shell-bg": { "$value": "#14171B", "$type": "color" },
      "panel": { "$value": "#1E2227", "$type": "color" },
      "surface": { "$value": "#1A1E23", "$type": "color" },
      "border": { "$value": "#2B3037", "$type": "color" },
      "text-title": { "$value": "#F1F4F7", "$type": "color" },
      "text-primary": { "$value": "#D5DBE2", "$type": "color" },
      "text-secondary": { "$value": "#8E98A4", "$type": "color" },
      "text-muted": { "$value": "#717B87", "$type": "color", "$description": "設計稿的表頭文字為 #7B8591，與分組標題 #717B87 差距極小，統一取 #717B87。" },
      "placeholder": { "$value": "#6E7884", "$type": "color" },
      "nav-item-text": { "$value": "#C3CAD3", "$type": "color" },
      "nav-item-icon": { "$value": "#8792A0", "$type": "color" },
      "nav-sub-text": { "$value": "#A9B2BD", "$type": "color" },
      "nav-guide": { "$value": "#30363D", "$type": "color" },
      "header-icon": { "$value": "#AEB7C2", "$type": "color" },
      "hover": { "$value": "#272C32", "$type": "color" },
      "subtle-bg": { "$value": "#252A30", "$type": "color" },
      "section-bg": { "$value": "#16191D", "$type": "color" },
      "section-border": { "$value": "#353B43", "$type": "color" },
      "row-border": { "$value": "#2A2F36", "$type": "color" },
      "row-hover": { "$value": "#22272D", "$type": "color" },
      "input-bg": { "$value": "#16191D", "$type": "color" },
      "input-border": { "$value": "#30363D", "$type": "color" },
      "secondary-bg": { "$value": "#2A2F36", "$type": "color" },
      "secondary-text": { "$value": "#D5DBE2", "$type": "color" },
      "modal-bg": { "$value": "#1E2227", "$type": "color" },
      "overlay": { "$value": "rgba(0,0,0,.6)", "$type": "color" }
    }
  },

  "semantic": {
    "$description": "語意色，只隨 light/dark 變化。success 改為圓角版的青綠系（狀態「使用中」膠囊）。danger-hover/pressed/suppl 為 NaiveUI 專用衍生態（推導），沿用 v1 行為不分明暗。on-accent 是疊在 accent 底色上的前景文字色，light/dark 同值。",
    "light": {
      "danger": { "$value": "#E5484D", "$type": "color" },
      "danger-bg": { "$value": "#FDECEC", "$type": "color", "$description": "刪除 icon 按鈕 hover 底色。" },
      "danger-hover": { "$value": "#E96368", "$type": "color", "$description": "推導：danger 混白 15%。" },
      "danger-pressed": { "$value": "#CA3F44", "$type": "color", "$description": "推導：danger 混黑 12%。" },
      "danger-suppl": { "$value": "#E96368", "$type": "color", "$description": "推導：同 danger-hover。" },
      "success": { "$value": "#19B395", "$type": "color", "$description": "狀態圓點。" },
      "success-bg": { "$value": "#DDF7F1", "$type": "color" },
      "success-text": { "$value": "#0D7A65", "$type": "color" },
      "on-accent": { "$value": "#FFFFFF", "$type": "color" }
    },
    "dark": {
      "danger": { "$value": "#FF6B6B", "$type": "color" },
      "danger-bg": { "$value": "rgba(255,107,107,.12)", "$type": "color" },
      "success": { "$value": "#33D1B2", "$type": "color" },
      "success-bg": { "$value": "rgba(51,209,178,.13)", "$type": "color" },
      "success-text": { "$value": "#5FE0C6", "$type": "color" },
      "on-accent": { "$value": "#FFFFFF", "$type": "color" }
    }
  },

  "brand": {
    "$description": "品牌輔助色（青綠），只隨 light/dark 變化。用於子選單選中態、日期 icon、分組標題前的小方塊。",
    "light": {
      "secondary": { "$value": "#33D1B2", "$type": "color", "$description": "分組標題前 6×6 小方塊。" },
      "secondary-icon": { "$value": "#19B395", "$type": "color", "$description": "header 日期 icon；設計稿子選單選中 icon 為 #17AE90，差距極小統一取此值。" },
      "sub-active-bg": { "$value": "#DDF7F1", "$type": "color" },
      "sub-active-text": { "$value": "#0D7A65", "$type": "color" }
    },
    "dark": {
      "secondary": { "$value": "#33D1B2", "$type": "color" },
      "secondary-icon": { "$value": "#33D1B2", "$type": "color" },
      "sub-active-bg": { "$value": "rgba(51,209,178,.13)", "$type": "color" },
      "sub-active-text": { "$value": "#5FE0C6", "$type": "color" }
    }
  },

  "accent": {
    "$description": "主色（WorksHub 品牌藍）。v2 取消主題色切換（v1 的 themes.blue/green/purple 整組移除），只隨 light/dark 變化。light 提供 NaiveUI 需要的 primary 衍生態；dark 提供 --app-accent 在暗色模式顯示的值。accent-strong = 有子項被選中時的父選單文字色；accent-icon = 父選單 icon 色、強調文字色。",
    "light": {
      "accent": { "$value": "#348BDD", "$type": "color" },
      "primary-hover": { "$value": "#2B7BC9", "$type": "color", "$description": "設計稿指定。注意：v1 hover 是變亮，v2 依設計改為變深。" },
      "primary-pressed": { "$value": "#266CB1", "$type": "color", "$description": "推導：hover 混黑 12%。" },
      "primary-suppl": { "$value": "#2B7BC9", "$type": "color" },
      "accent-strong": { "$value": "#124479", "$type": "color" },
      "accent-icon": { "$value": "#348BDD", "$type": "color" }
    },
    "dark": {
      "accent": { "$value": "#5FA8EB", "$type": "color", "$description": "暗色模式下的強調文字/icon；選中態底色仍用 light.accent #348BDD（與設計稿一致）。" },
      "accent-strong": { "$value": "#8CC4F2", "$type": "color" },
      "accent-icon": { "$value": "#5FA8EB", "$type": "color" }
    }
  },

  "button": {
    "$description": "主要按鈕專用色（決議 2026-10-02）。為提高白字對比，主要按鈕底色比主色 accent 深一階（白字對比 4.39，原 #348BDD 為 3.57）。只套用在 Button type=primary；選單選中、勾選框、開關、連結仍用 accent。light/dark 同值。NaiveUI 請用 Button 的 themeOverrides（colorPrimary / colorHoverPrimary / colorPressedPrimary / colorFocusPrimary 與對應 border）覆寫，不要改 common.primaryColor。",
    "primary-bg": { "$value": "#2B7BC9", "$type": "color" },
    "primary-bg-hover": { "$value": "#266CB1", "$type": "color", "$description": "比照設計稿 hover 變深的方向，取原 pressed 值（白字對比 5.44）。" },
    "primary-bg-pressed": { "$value": "#215F9C", "$type": "color", "$description": "推導：hover 混黑 12%（白字對比 6.60）。" }
  },

  "gradient": {
    "$description": "品牌漸層，light/dark 共用。$value 為 CSS 字串。",
    "brand": { "$value": "linear-gradient(135deg,#33D1B2,#348BDD)", "$type": "gradient", "$description": "使用者頭像、空狀態 icon、彈窗標題 icon、成員頭像（樣式一）。" },
    "brand-deep": { "$value": "linear-gradient(135deg,#348BDD,#124479)", "$type": "gradient", "$description": "成員頭像（樣式三）。" }
  },

  "shadow": {
    "$description": "陰影，只隨 light/dark 變化。$value 為 CSS box-shadow 字串。",
    "light": {
      "accent": { "$value": "0 6px 14px -6px rgba(52,139,221,.6)", "$type": "shadow", "$description": "主要按鈕、選單選中項目下方的同色光暈。" },
      "modal": { "$value": "0 30px 70px -20px rgba(15,30,50,.4)", "$type": "shadow" }
    },
    "dark": {
      "accent": { "$value": "0 6px 16px -6px rgba(52,139,221,.7)", "$type": "shadow" },
      "modal": { "$value": "0 30px 70px -20px rgba(0,0,0,.7)", "$type": "shadow" }
    }
  },

  "chart": {
    "$description": "資料視覺化色盤（ECharts 分類色），與品牌/語意色分開管理。v2 未變動。",
