---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import lock from '../data/about.lock.json';
---
<Base title="關於我" description="黃思敏的經歷、能力與自我介紹（需密碼）。">
  <section class="about-hero">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>關於我</h1>
    </div>
    <span class="deco" aria-hidden="true" data-speed="0.12">ABOUT</span>
  </section>

  <div class="wrap">
    <!-- 密碼門 -->
    <form id="gate" class="gate" novalidate>
      <svg class="lock" width="40" height="48" viewBox="0 0 12 14" aria-hidden="true"><rect x="1" y="6" width="10" height="7.5" rx="1.5" fill="currentColor"/><path d="M3 6V4.2a3 3 0 0 1 6 0V6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      <h2>這一頁需要密碼</h2>
      <p>經歷與自我介紹僅提供給面試與招募夥伴。若你需要密碼，請透過下方聯絡管道與我聯繫。</p>
      <label for="pw">請輸入 4 位數密碼</label>
      <div class="row">
        <input id="pw" name="pw" type="password" inputmode="numeric" autocomplete="off" maxlength="4" pattern="[0-9]{4}" required aria-describedby="gate-msg" />
        <button class="btn" type="submit">解鎖 <span class="arrow" aria-hidden="true">→</span></button>
      </div>
      <p id="gate-msg" class="msg" role="status" aria-live="polite"></p>
    </form>

    <!-- 解鎖後內容 -->
    <section id="content" class="unlocked" hidden aria-labelledby="content-title">
      <h2 id="content-title" class="sr-only" tabindex="-1">關於我：完整內容</h2>
      <div id="about-body" class="prose"></div>
    </section>

    <div class="contact-block">
      <h2>聯絡與履歷</h2>
      <ContactLinks tone="light" />
    </div>
  </div>

  <script type="application/json" id="about-lock" set:html={JSON.stringify(lock)}></script>
</Base>

<script>
  const lock = JSON.parse(document.getElementById('about-lock')!.textContent!);
  const form = document.getElementById('gate') as HTMLFormElement;
  const input = document.getElementById('pw') as HTMLInputElement;
  const msg = document.getElementById('gate-msg')!;
  const content = document.getElementById('content')!;
  const body = document.getElementById('about-body')!;
  const KEY = 'about-pw';

  const bytes = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

  async function decrypt(password: string) {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: bytes(lock.salt), iterations: lock.iterations, hash: 'SHA-256' },
      base,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(lock.iv) }, key, bytes(lock.data));
    return new TextDecoder().decode(plain);
  }

  async function unlock(password: string, focus: boolean) {
    const html = await decrypt(password); // 密碼錯誤時會丟出錯誤
    body.innerHTML = html;
    form.hidden = true;
    content.hidden = false;
    try { sessionStorage.setItem(KEY, password); } catch {}
    if (focus) document.getElementById('content-title')!.focus();
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pw = input.value.trim();
    if (!/^\d{4}$/.test(pw)) {
      msg.textContent = '請輸入 4 位數字。';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    msg.textContent = '解鎖中…';
    form.setAttribute('aria-busy', 'true');
    try {
      await unlock(pw, true);
    } catch {
      msg.textContent = '密碼不正確，請再試一次。';
      input.setAttribute('aria-invalid', 'true');
      input.select();
    } finally {
      form.removeAttribute('aria-busy');
    }
  });

  // 同一個分頁內解鎖過，就不用重輸
  let saved: string | null = null;
  try { saved = sessionStorage.getItem(KEY); } catch {}
  if (saved) unlock(saved, false).catch(() => { try { sessionStorage.removeItem(KEY); } catch {} });
</script>

<style>
  .about-hero { position: relative; overflow: hidden; background: var(--ink); color: var(--paper); padding-block: clamp(56px, 10vw, 120px); }
  .about-hero .wrap { position: relative; z-index: 1; }
  h1 { font-size: clamp(3rem, 10vw, 8rem); letter-spacing: -0.02em; margin-top: 12px; }
  .deco {
    position: absolute; right: -0.06em; bottom: -0.2em; line-height: 1; pointer-events: none;
    font-family: var(--font-display); font-size: clamp(6rem, 22vw, 20rem);
    color: var(--accent); opacity: 0.9;
  }
  .gate {
    max-width: 560px; margin: clamp(48px, 8vw, 96px) 0; padding: clamp(24px, 4vw, 40px);
    border: 2px solid var(--ink); border-radius: calc(var(--radius) * 1.2);
    background: color-mix(in srgb, var(--accent) 22%, var(--paper));
  }
  .gate[hidden] { display: none; }
  .gate h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 16px 0 10px; }
  .gate p { color: var(--ink-soft); }
  label { display: block; font-weight: 700; margin: 20px 0 8px; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }
  input {
    flex: 1 1 160px; min-width: 0; font: inherit; font-family: var(--font-display); font-size: 1.6rem; letter-spacing: 0.5em;
    padding: 10px 16px; border: 2px solid var(--ink); border-radius: 12px; background: var(--paper); color: var(--ink);
  }
  input[aria-invalid='true'] { border-width: 3px; }
  .msg { min-height: 1.6em; margin: 12px 0 0; font-weight: 700; color: var(--ink) !important; }
  .gate[aria-busy='true'] button { opacity: 0.6; pointer-events: none; }
  .unlocked { padding-block: clamp(24px, 6vw, 64px); }
  .contact-block { border-top: 2px solid var(--ink); padding-block: 40px clamp(64px, 10vw, 120px); }
  .contact-block h2 { font-size: 1.6rem; margin-bottom: 20px; }
</style>
