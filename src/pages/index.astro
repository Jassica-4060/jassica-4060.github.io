---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Logo from '../assets/logo.svg';
import { profile } from '../data/profile';

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const main = cases.filter((c) => c.data.tier === 'main');
const side = cases.filter((c) => c.data.tier === 'side');
const variants = ['ink', 'accent', 'paper'] as const;
const marquee = '需求收斂 ✦ 產品設計 ✦ Design System ✦ 跨部門溝通 ✦ ';
---
<Base>
  <!-- ① Hero：10 秒內回答「我是誰」 -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-logo" data-speed="0.25" aria-hidden="true"><Logo /></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">{profile.name}・{profile.title}・{profile.location}</p>
      <h1 id="hero-title">
        <span class="line">我把混亂的需求，</span>
        <span class="line typed">
          <span class="sr-only">{profile.typewriter.join(' ')}</span>
          <span data-typewriter={JSON.stringify(profile.typewriter)} aria-hidden="true">{profile.typewriter[0]}</span><span class="caret" aria-hidden="true"></span>
        </span>
      </h1>
      <p class="lead">{profile.positioning}{profile.intro}</p>
      <ul class="keywords" aria-label="核心關鍵字">
        {profile.keywords.map((k) => <li class="tag">{k}</li>)}
      </ul>
      <div class="actions">
        <a class="btn" href="#work">看精選作品 <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn btn--ghost" href="#contact">聯絡我／履歷</a>
      </div>
    </div>
  </section>

  <!-- 捲動帶動的超大裝飾字 -->
  <div class="band" aria-hidden="true">
    <p class="band-text" data-marquee="left">{marquee.repeat(4)}</p>
  </div>

  <!-- ② 精選作品 -->
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="eyebrow">Selected Work</p>
        <h2 id="work-title">精選作品</h2>
        <p>三個主案例展示我如何收斂需求、交付規格與建立設計系統；其他作品補強視覺與完整交付能力。</p>
      </header>

      <div class="stack">
        {main.map((entry, i) => (
          <div class="stack-item" style={`--i:${i}`}>
            <CaseCard entry={entry} index={i} variant={variants[i % 3]} />
          </div>
        ))}
      </div>

      <h3 class="side-title reveal">其他作品<span>補強視覺與完整交付</span></h3>
      <div class="side-grid">
        {side.map((entry, i) => (
          <div class="reveal" style={`transition-delay:${i * 120}ms`}>
            <CaseCard entry={entry} index={i} variant={i % 2 ? 'accent' : 'paper'} size="sm" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ③ 工作方式：設計理念與特質 -->
  <section id="approach" class="approach" aria-labelledby="approach-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="eyebrow">How I Work</p>
        <h2 id="approach-title">工作方式</h2>
      </header>
      <blockquote class="quote">
        <p data-speed="0.08">「{profile.philosophy}」</p>
      </blockquote>
      <ol class="traits">
        {profile.traits.map((t, i) => (
          <li class="trait reveal" style={`transition-delay:${i * 120}ms`}>
            <span class="trait-en">{t.en}</span>
            <h3>{t.name}</h3>
            <p>{t.body}</p>
          </li>
        ))}
      </ol>
      <p class="difference reveal">{profile.difference}</p>
    </div>
  </section>

  <!-- ④ 聯絡 -->
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="band band--dark" aria-hidden="true">
      <p class="band-text" data-marquee="right">LET’S TALK ✦ LET’S TALK ✦ LET’S TALK ✦ LET’S TALK ✦ LET’S TALK ✦ </p>
    </div>
    <div class="wrap contact-inner">
      <h2 id="contact-title" class="reveal">一起聊聊下一個<br />複雜的產品問題。</h2>
      <p class="reveal">履歷與聯絡管道如下；完整的經歷與自我介紹在「關於我」（需密碼）。</p>
      <div class="reveal"><ContactLinks tone="dark" /></div>
      <a class="btn btn--accent reveal" href="/about/">前往關於我（需密碼）<span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; overflow: hidden; min-height: calc(100svh - 68px); display: grid; align-items: center; padding-block: clamp(48px, 8vh, 96px); }
  .hero-logo {
    position: absolute; right: -6vw; top: 8%; width: min(70vw, 900px); z-index: 0;
    color: var(--ink); opacity: 0.07; pointer-events: none;
    --logo-fill: transparent;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero h1 { margin: 24px 0 28px; font-size: clamp(2.3rem, 7.4vw, 6.6rem); line-height: 1.12; letter-spacing: -0.01em; }
  .line { display: block; }
  .typed { color: var(--ink); min-height: 1.12em; }
  .typed [data-typewriter] { background: linear-gradient(transparent 62%, var(--accent) 62%); }
  .caret { display: inline-block; width: 0.08em; height: 0.9em; margin-left: 0.06em; background: var(--ink); vertical-align: -0.08em; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 760px) { .typed { min-height: 2.24em; } }
  .lead { max-width: 40em; font-size: clamp(1rem, 1.2vw + 0.6rem, 1.2rem); color: var(--ink-soft); }
  .keywords { list-style: none; padding: 0; margin: 0 0 32px; display: flex; flex-wrap: wrap; gap: 8px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  /* 超大裝飾字帶 */
  .band { background: var(--accent); overflow: hidden; padding-block: 8px; border-block: 2px solid var(--ink); }
  .band--dark { background: var(--ink); color: var(--accent); border-color: var(--ink); }
  .band-text {
    margin: 0; white-space: nowrap; width: max-content; will-change: transform;
    font-family: var(--font-display); font-weight: 900; line-height: 1.15;
    font-size: clamp(3rem, 10vw, 9rem); letter-spacing: -0.02em;
  }

  /* 段落標題 */
  .sec-head { margin-bottom: clamp(32px, 6vw, 72px); max-width: 44em; }
  .sec-head h2 { font-size: clamp(2.6rem, 8vw, 6.4rem); margin: 12px 0 16px; letter-spacing: -0.02em; }
  .sec-head p:last-child { color: var(--ink-soft); }

  /* 作品：疊卡效果 */
  .work { padding-block: clamp(72px, 12vw, 160px); }
  .stack { display: grid; gap: 24px; }
  .stack-item { position: sticky; top: calc(88px + var(--i) * 28px); }
  .side-title { margin: clamp(64px, 10vw, 120px) 0 24px; font-size: clamp(1.6rem, 3vw, 2.4rem); display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; }
  .side-title span { font-size: 1rem; font-weight: 700; color: var(--ink-soft); }
  .side-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 24px; }
  @media (max-width: 720px) { .stack-item { position: static; } }

  /* 工作方式 */
  .approach { padding-block: clamp(72px, 12vw, 160px); border-top: 2px solid var(--ink); }
  .quote { margin: 0 0 clamp(48px, 8vw, 96px); }
  .quote p { margin: 0; text-wrap: balance; font-size: clamp(2rem, 6vw, 5.2rem); font-weight: 900; line-height: 1.2; letter-spacing: -0.01em; }
  .traits { list-style: none; padding: 0; margin: 0 0 clamp(48px, 8vw, 96px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .trait { border-top: 6px solid var(--ink); padding-top: 20px; }
  .trait-en { font-family: var(--font-display); font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase; background: var(--accent); padding: 2px 8px; }
  .trait h3 { font-size: 1.8rem; margin: 14px 0 10px; }
  .trait p { color: var(--ink-soft); }
  .difference { max-width: 44em; font-size: clamp(1.05rem, 1.4vw + 0.5rem, 1.35rem); font-weight: 500; }

  /* 聯絡 */
  .contact { background: var(--ink); color: var(--paper); }
  .contact-inner { padding-block: clamp(72px, 12vw, 140px); display: grid; gap: 24px; justify-items: start; }
  .contact h2 { font-size: clamp(2.2rem, 6.4vw, 5.6rem); letter-spacing: -0.01em; }
  .contact-inner p { margin: 0; color: color-mix(in srgb, var(--paper) 85%, var(--ink)); }
</style>
