---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={`${d.product}｜${d.title}`} description={d.summary}>
  <article>
    <header class="case-hero">
      <div class="wrap">
        <a class="back" href="/#work">← 回到作品</a>
        <p class="eyebrow">{d.tier === 'main' ? '主案例' : '其他作品'}・{d.product}</p>
        <h1>{d.title}</h1>
        <p class="summary">{d.summary}</p>
        <dl class="facts">
          <div><dt>我的角色</dt><dd>{d.role}</dd></div>
          <div><dt>期間</dt><dd>{d.duration}</dd></div>
          <div><dt>展現能力</dt><dd><ul>{d.proves.map((p) => <li class="tag">{p}</li>)}</ul></dd></div>
        </dl>
      </div>
      <span class="big-num" aria-hidden="true" data-speed="0.15">{String(d.order).padStart(2, '0')}</span>
    </header>

    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="next" aria-label="下一個案例">
    <a href={`/work/${next.id}/`} class="wrap next-inner">
      <span class="eyebrow">下一個案例</span>
      <span class="next-title">{next.data.product}｜{next.data.title} <span class="arrow" aria-hidden="true">→</span></span>
    </a>
  </nav>
</Base>

<style>
  .case-hero { position: relative; overflow: hidden; background: var(--accent); border-bottom: 2px solid var(--ink); padding-block: clamp(40px, 8vw, 96px); }
  .case-hero .wrap { position: relative; z-index: 1; }
  .back { display: block; width: fit-content; margin-bottom: 32px; font-weight: 700; text-underline-offset: 4px; }
  h1 { font-size: clamp(2.4rem, 8vw, 6.8rem); letter-spacing: -0.02em; margin: 16px 0 20px; max-width: 12em; }
  .summary { font-size: clamp(1.05rem, 1.4vw + 0.5rem, 1.4rem); font-weight: 500; max-width: 32em; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px 32px; margin: 40px 0 0; }
  .facts div { border-top: 2px solid var(--ink); padding-top: 12px; }
  dt { font-size: 0.82rem; font-weight: 900; letter-spacing: 0.12em; margin-bottom: 6px; }
  dd { margin: 0; font-weight: 500; }
  dd ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .big-num {
    position: absolute; right: -0.05em; top: -0.12em; line-height: 1; z-index: 0; pointer-events: none;
    font-family: var(--font-display); font-size: clamp(10rem, 32vw, 28rem);
    color: transparent; -webkit-text-stroke: 2px var(--ink); opacity: 0.25;
  }
  .body { padding-block: clamp(24px, 6vw, 72px) clamp(72px, 10vw, 120px); }
  .next { background: var(--ink); color: var(--paper); }
  .next-inner { display: grid; gap: 12px; padding-block: clamp(48px, 8vw, 96px); text-decoration: none; }
  .next-title { font-size: clamp(1.8rem, 5vw, 4rem); font-weight: 900; line-height: 1.2; }
  .next-title .arrow { display: inline-block; color: var(--accent); transition: transform 0.3s var(--ease); }
  .next-inner:hover .arrow { transform: translateX(10px); }
</style>
